# Copiar a .env y rellenar. Nunca commitear .env.
#
# Si falta cualquiera de las obligatorias, el proceso NO arranca y dice cual.

# --- Postgres (obligatorias) -------------------------------------------------

# En produccion se rellenan con los datos del POOLER de Supabase (puerto 6543),
# no de la conexion directa.
DB_HOST=localhost
DB_PORT=5440
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_DATABASE_NAME=portafolio

# Base de datos de los tests de integracion.
#
# TIENE que terminar en "_test" y ser distinta de DB_DATABASE_NAME: `pnpm
# test:e2e` borra el esquema completo antes de correr, y una instancia local de
# desarrollo suele alojar muchas bases. Si no existe, la crea el propio test.
DB_DATABASE_NAME_TEST=portafolio_test

# --- Autenticacion -----------------------------------------------------------

# Firma de los JWT. OBLIGATORIO, minimo 32 caracteres, sin valor por defecto:
# un secreto con valor por defecto es un secreto publico. Generar con:
#
#   pnpm secrets
#
JWT_SECRET=

# Vigencia del token en segundos. 28800 = 8 horas, una jornada de trabajo.
JWT_EXPIRES_IN_SECONDS=28800

# Credenciales del PRIMER administrador, solo para el arranque inicial. Se
# ignoran en cuanto exista un admin en la base de datos, asi que cambiar la
# contraseña se hace por API, no editando esto. `pnpm secrets` genera el hash.
#
# Si faltan, la API arranca igual (la lectura publica funciona) pero avisa por
# consola de que nadie puede autenticarse.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Candado de Swagger UI (/docs). En produccion son OBLIGATORIAS: sin ellas la
# pagina no se monta, porque /docs es el panel de administracion provisional. En
# desarrollo, dejarlas vacias monta /docs sin candado.
DOCS_USER=
DOCS_PASSWORD=

# --- Opcionales --------------------------------------------------------------

NODE_ENV=development

# Lo inyecta Render en produccion. 3001 en local para no chocar con el front,
# que usa el 3000.
PORT=3001

# Origenes permitidos, separados por coma. Vacio significa NINGUNO.
CORS_ORIGINS=http://localhost:3000

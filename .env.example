# Copiar a .env y rellenar. Nunca commitear .env.
#
# Si falta cualquiera de las obligatorias, el proceso NO arranca y dice cual.

# --- Obligatorias -----------------------------------------------------------

# Postgres. En local, la del docker-compose de este repositorio.
# En produccion, la cadena del POOLER de Supabase (puerto 6543), no la directa.
DATABASE_URL=postgres://portafolio:portafolio@localhost:5432/portafolio

# --- Opcionales -------------------------------------------------------------

NODE_ENV=development

# Lo inyecta Render en produccion. 3001 en local para no chocar con el front,
# que usa el 3000.
PORT=3001

# Origenes permitidos, separados por coma. Vacio significa NINGUNO.
CORS_ORIGINS=http://localhost:3000

# Copiar a .env y rellenar. Nunca commitear .env.
#
# Si falta cualquiera de las obligatorias, el proceso NO arranca y dice cual.

# --- Postgres (obligatorias) -------------------------------------------------

# En produccion se rellenan con los datos del POOLER de Supabase (puerto 6543),
# no de la conexion directa.
DB_HOST=localhost
DB_PORT=5440
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_DATABASE_NAME=portafolio

# Base de datos de los tests de integracion.
#
# TIENE que terminar en "_test" y ser distinta de DB_DATABASE_NAME: `pnpm
# test:e2e` borra el esquema completo antes de correr, y una instancia local de
# desarrollo suele alojar muchas bases. Si no existe, la crea el propio test.
DB_DATABASE_NAME_TEST=portafolio_test

# --- Opcionales --------------------------------------------------------------

NODE_ENV=development

# Lo inyecta Render en produccion. 3001 en local para no chocar con el front,
# que usa el 3000.
PORT=3001

# Origenes permitidos, separados por coma. Vacio significa NINGUNO.
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://portafolio:portafolio@localhost:5432/portafolio

# --- Opcionales -------------------------------------------------------------

NODE_ENV=development

# Lo inyecta Render en produccion. 3001 en local para no chocar con el front,
# que usa el 3000.
PORT=3001

# Origenes permitidos, separados por coma. Vacio significa NINGUNO.
CORS_ORIGINS=http://localhost:3000

DB_HOST=localhost
DB_PORT=5440
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_DATABASE_NAME=portafolio
